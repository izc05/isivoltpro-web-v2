---
---
<div class="eco-cutaway" data-cutaway aria-label="Visual conceptual de un edificio técnico conectado por IsiVoltPro">
  <span class="eco-cutaway-label">Visual conceptual</span>

  <div class="eco-building" aria-hidden="true">
    <div class="eco-building-shell"></div>
    <div class="eco-floor eco-floor--roof">
      <div class="eco-room eco-room--hvac">
        <span class="eco-room-name">HVAC</span>
        <span class="eco-equipment eco-equipment--uta"></span>
        <span class="eco-light-mask eco-light-mask--hvac"></span>
      </div>
      <div class="eco-room eco-room--services">
        <span class="eco-room-name">Servicios</span>
        <span class="eco-light-mask eco-light-mask--services"></span>
      </div>
    </div>

    <div class="eco-floor eco-floor--middle">
      <div class="eco-room eco-room--electrical">
        <span class="eco-room-name">Electricidad</span>
        <span class="eco-equipment eco-equipment--panel"></span>
        <span class="eco-light-mask eco-light-mask--electrical"></span>
      </div>
      <div class="eco-room eco-room--rooms">
        <span class="eco-room-name">Instalación</span>
        <span class="eco-light-mask eco-light-mask--room-a"></span>
        <span class="eco-light-mask eco-light-mask--room-b"></span>
      </div>
    </div>

    <div class="eco-floor eco-floor--plant">
      <div class="eco-room eco-room--water">
        <span class="eco-room-name">Bombeo</span>
        <span class="eco-equipment eco-equipment--pump eco-equipment--pump-a"></span>
        <span class="eco-equipment eco-equipment--pump eco-equipment--pump-b"></span>
        <span class="eco-light-mask eco-light-mask--water"></span>
      </div>
      <div class="eco-room eco-room--asset">
        <span class="eco-room-name">Activo</span>
        <span class="eco-asset-chip">UTA-02</span>
      </div>
    </div>
  </div>

  <span class="eco-monitor-dot eco-monitor-dot--hvac" aria-hidden="true"></span>
  <span class="eco-monitor-dot eco-monitor-dot--electrical" aria-hidden="true"></span>
  <span class="eco-monitor-dot eco-monitor-dot--water" aria-hidden="true"></span>

  <div class="eco-cutaway-legend">
    <span><i class="is-live"></i>Sistema activo</span>
    <span><i class="is-linked"></i>Monitorización</span>
  </div>
</div>
