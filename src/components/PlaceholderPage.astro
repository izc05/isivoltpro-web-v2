---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Motion from './Motion.astro';
import '../styles/global.css';
import '../styles/placeholders.css';

interface Props { kicker: string; title: string; description: string; }
const { kicker, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111d" />
    <title>{title} · IsiVoltPro</title>
  </head>
  <body>
    <SiteHeader />
    <main class="placeholder-main">
      <section class="placeholder-hero">
        <div class="shell" data-reveal>
          <p class="kicker">{kicker}</p>
          <h1>{title}</h1>
          <p>{description}</p>
          <a class="button button-primary" href={base}>Volver a la Home <span>→</span></a>
        </div>
      </section>
    </main>
    <SiteFooter />
    <Motion />
  </body>
</html>
