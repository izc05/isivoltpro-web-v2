<style is:global>
  html.is-page-hidden .hero-light,
  html.is-page-hidden .hero-monitor,
  html.is-page-hidden .hero-haze,
  html.is-page-hidden .hero-beam,
  html.is-page-hidden .hero-reflection,
  html.is-page-hidden .hero-energy-line i,
  html.is-page-hidden .hero-energy-node,
  html.is-page-hidden .hero-control-screen,
  html.is-page-hidden .hero-control-screen::before,
  html.is-page-hidden .hero-control-screen i,
  html.is-page-hidden .hero-control-screen b,
  html.is-page-hidden .hero-control-halo,
  html.is-page-hidden .hero-status-led,
  html.is-page-hidden .closing-light,
  html.is-page-hidden .closing-monitor,
  html.is-page-hidden .eco-light-mask,
  html.is-page-hidden .eco-monitor-dot {
    animation-play-state: paused !important;
  }
</style>

<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const header = document.querySelector('[data-header]');
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-menu]');
    const hero = document.querySelector('[data-hero-motion]');
    const cutaway = document.querySelector('[data-cutaway]');

    const setMenu = (open) => {
      menu?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (toggle) toggle.textContent = open ? '×' : '☰';
    };

    toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });

    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

    const syncVisibility = () => {
      document.documentElement.classList.toggle('is-page-hidden', document.hidden);
    };
    document.addEventListener('visibilitychange', syncVisibility);
    syncVisibility();

    if (reduced) document.documentElement.dataset.reducedMotion = 'true';

    const setPointerDepth = (element, event, prefix, maxX, maxY) => {
      if (!element || reduced || coarse) return;
      const rect = element.getBoundingClientRect();
      const nx = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      const ny = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
      element.style.setProperty(`--${prefix}-pan-x`, `${(nx * maxX).toFixed(2)}px`);
      element.style.setProperty(`--${prefix}-pan-y`, `${(ny * maxY).toFixed(2)}px`);
      element.style.setProperty(`--${prefix}-tilt-x`, `${(nx * 1.25).toFixed(2)}deg`);
      element.style.setProperty(`--${prefix}-tilt-y`, `${(ny * -0.8).toFixed(2)}deg`);
    };

    const resetPointerDepth = (element, prefix) => {
      if (!element) return;
      element.style.setProperty(`--${prefix}-pan-x`, '0px');
      element.style.setProperty(`--${prefix}-pan-y`, '0px');
      element.style.setProperty(`--${prefix}-tilt-x`, '0deg');
      element.style.setProperty(`--${prefix}-tilt-y`, '0deg');
    };

    /* Hero 2,5D fuerte: el fondo apenas se mueve y los planos físicos ganan amplitud. */
    let heroTargetX = 0;
    let heroTargetY = 0;
    let heroCurrentX = 0;
    let heroCurrentY = 0;
    let heroDepthFrame = 0;

    const writeHeroDepth = () => {
      if (!hero || reduced || coarse) {
        heroDepthFrame = 0;
        return;
      }

      heroCurrentX += (heroTargetX - heroCurrentX) * 0.095;
      heroCurrentY += (heroTargetY - heroCurrentY) * 0.095;

      const x = heroCurrentX;
      const y = heroCurrentY;

      /* Fondo / cámara */
      hero.style.setProperty('--hero-bg-x', `${(-x * 7).toFixed(2)}px`);
      hero.style.setProperty('--hero-bg-y', `${(-y * 4).toFixed(2)}px`);

      /* Capas físicas recortadas de la propia fotografía. */
      hero.style.setProperty('--hero-upper-x', `${(-x * 15).toFixed(2)}px`);
      hero.style.setProperty('--hero-upper-y', `${(-y * 9).toFixed(2)}px`);
      hero.style.setProperty('--hero-middle-x', `${(-x * 23).toFixed(2)}px`);
      hero.style.setProperty('--hero-middle-y', `${(-y * 14).toFixed(2)}px`);
      hero.style.setProperty('--hero-lower-x', `${(-x * 31).toFixed(2)}px`);
      hero.style.setProperty('--hero-lower-y', `${(-y * 18).toFixed(2)}px`);
      hero.style.setProperty('--hero-equipment-x', `${(-x * 40).toFixed(2)}px`);
      hero.style.setProperty('--hero-equipment-y', `${(-y * 23).toFixed(2)}px`);

      /* Capas de vida: progresivamente más próximas al usuario. */
      hero.style.setProperty('--hero-atmo-x', `${(-x * 12).toFixed(2)}px`);
      hero.style.setProperty('--hero-atmo-y', `${(-y * 7).toFixed(2)}px`);
      hero.style.setProperty('--hero-light-x', `${(-x * 17).toFixed(2)}px`);
      hero.style.setProperty('--hero-light-y', `${(-y * 10).toFixed(2)}px`);
      hero.style.setProperty('--hero-energy-x', `${(-x * 25).toFixed(2)}px`);
      hero.style.setProperty('--hero-energy-y', `${(-y * 15).toFixed(2)}px`);
      hero.style.setProperty('--hero-ui-x', `${(-x * 33).toFixed(2)}px`);
      hero.style.setProperty('--hero-ui-y', `${(-y * 19).toFixed(2)}px`);

      /* Inclinación global limitada: perceptible, sin sensación de tarjeta 3D. */
      hero.style.setProperty('--hero-tilt-x', `${(-y * 0.58).toFixed(3)}deg`);
      hero.style.setProperty('--hero-tilt-y', `${(x * 0.82).toFixed(3)}deg`);

      const moving = Math.abs(heroTargetX - heroCurrentX) > 0.002 || Math.abs(heroTargetY - heroCurrentY) > 0.002;
      if (moving) {
        heroDepthFrame = requestAnimationFrame(writeHeroDepth);
      } else {
        heroCurrentX = heroTargetX;
        heroCurrentY = heroTargetY;
        heroDepthFrame = 0;
      }
    };

    const wakeHeroDepth = () => {
      if (!heroDepthFrame && hero && !reduced && !coarse) {
        heroDepthFrame = requestAnimationFrame(writeHeroDepth);
      }
    };

    const setHeroDepthTarget = (event) => {
      if (!hero || reduced || coarse) return;
      const rect = hero.getBoundingClientRect();
      const px = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
      const py = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
      heroTargetX = (px - 0.5) * 2;
      heroTargetY = (py - 0.5) * 2;
      hero.style.setProperty('--hero-pointer-x', `${(px * 100).toFixed(2)}%`);
      hero.style.setProperty('--hero-pointer-y', `${(py * 100).toFixed(2)}%`);
      hero.style.setProperty('--hero-pointer-opacity', '.22');
      wakeHeroDepth();
    };

    const resetHeroDepth = () => {
      if (!hero) return;
      heroTargetX = 0;
      heroTargetY = 0;
      hero.style.setProperty('--hero-pointer-opacity', '0');
      wakeHeroDepth();
    };

    if (!reduced && !coarse) {
      hero?.addEventListener('pointermove', setHeroDepthTarget, { passive: true });
      hero?.addEventListener('pointerleave', resetHeroDepth, { passive: true });
      hero?.addEventListener('pointercancel', resetHeroDepth, { passive: true });

      cutaway?.addEventListener('pointermove', (event) => setPointerDepth(cutaway, event, 'eco', 7, 5), { passive: true });
      cutaway?.addEventListener('pointerleave', () => resetPointerDepth(cutaway, 'eco'));
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        header?.classList.toggle('is-scrolled', y > 22);
        if (!reduced && !coarse) {
          document.documentElement.style.setProperty('--hero-shift', `${Math.min(y * 0.08, 38)}px`);
          const cutawayRect = cutaway?.getBoundingClientRect();
          if (cutaway && cutawayRect) {
            const viewportCenter = window.innerHeight / 2;
            const cutawayCenter = cutawayRect.top + cutawayRect.height / 2;
            const normalized = Math.max(-1, Math.min(1, (cutawayCenter - viewportCenter) / window.innerHeight));
            cutaway.style.setProperty('--eco-scroll-y', `${(-normalized * 7).toFixed(2)}px`);
          }
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
