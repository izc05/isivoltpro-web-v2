---
import '../styles/header-themes.css';
interface Props { theme?: 'dark' | 'light'; }
const { theme = 'dark' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
---
<header class:list={['site-header', theme === 'light' && 'is-light']} data-header>
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="IsiVoltPro inicio">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ISIVOLT<span>PRO</span></span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>☰</button>

    <nav class="main-nav" aria-label="Navegación principal" data-menu>
      <a href={withBase('/ecosistema')}>Ecosistema</a>
      <a href={withBase('/aplicaciones')}>Aplicaciones</a>
      <a href={withBase('/mantenimiento')}>Mantenimiento</a>
      <a href={withBase('/recursos')}>Recursos</a>
      <a href={withBase('/empresa')}>Empresa</a>
    </nav>

    <a class="header-cta" href={withBase('/contacto')}>Solicitar demo <span>↗</span></a>
  </div>
</header>
