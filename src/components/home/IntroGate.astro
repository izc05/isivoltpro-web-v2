---
import '../../styles/home-entry.css';
---
<section class="intro-gate intro-gate--aperture" data-intro-gate aria-label="Portada de IsiVoltPro">
  <div class="intro-aperture" aria-hidden="true">
    <span class="intro-aperture__halo"></span>
    <span class="intro-aperture__line"></span>
    <span class="intro-aperture__flare"></span>
  </div>

  <div class="intro-topbar">
    <a class="intro-brand" href="#" aria-label="IsiVoltPro">
      <span class="intro-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ISIVOLT<span>PRO</span></span>
    </a>
    <span class="intro-status">SISTEMA / 01</span>
  </div>

  <div class="intro-content">
    <p class="intro-eyebrow">CONTROL · CONTEXTO · DECISIÓN</p>
    <h1>
      <span>La instalación</span>
      <strong>empieza aquí.</strong>
    </h1>
    <p class="intro-lead">Una única plataforma para ver lo que tienes, lo que ocurre y lo que hay que hacer.</p>

    <button class="intro-enter" type="button" data-intro-enter>
      <span>Entrar</span>
      <i aria-hidden="true">→</i>
    </button>
  </div>

  <button class="intro-scroll" type="button" data-intro-enter aria-label="Entrar en IsiVoltPro">
    <span>DESCUBRIR</span>
    <i aria-hidden="true"></i>
  </button>

  <p class="intro-signature" aria-hidden="true">ISIVOLTPRO · PLATAFORMA PARA INSTALACIONES TÉCNICAS</p>
</section>

<script is:inline>
  (() => {
    const gate = document.querySelector('[data-intro-gate]');
    if (!gate) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const triggers = gate.querySelectorAll('[data-intro-enter]');
    let leaving = false;

    const openSite = () => {
      if (leaving) return;
      leaving = true;
      gate.classList.add('is-opening');

      const video = document.querySelector('[data-hero-video]');
      if (video instanceof HTMLVideoElement) {
        try { video.currentTime = 0; } catch (_) {}
        video.play().catch(() => {});
      }

      window.setTimeout(() => {
        gate.classList.add('is-leaving');
        document.body.classList.remove('has-intro');
      }, reduced ? 0 : 360);

      window.setTimeout(() => gate.remove(), reduced ? 40 : 1080);
    };

    requestAnimationFrame(() => gate.classList.add('is-ready'));
    triggers.forEach((trigger) => trigger.addEventListener('click', openSite));

    window.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaY) > 18) openSite();
    }, { passive: true, once: true });

    window.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'PageDown', 'Enter', ' ', 'Escape'].includes(event.key)) openSite();
    }, { once: true });
  })();
</script>
