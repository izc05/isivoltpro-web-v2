---
import '../../styles/intro-cinematic.css';
import '../../styles/intro-hotfix.css';

interface Props {
  base: string;
}

const { base } = Astro.props;
const imageUrl = `${base}images/intro-cinematic/intro.webp`;
---
<section class="intro-cinematic" data-intro aria-label="Portada de IsiVoltPro">
  <div class="intro-image" style={`background-image:url('${imageUrl}')`} aria-hidden="true"></div>
  <div class="intro-depth" aria-hidden="true"></div>
  <div class="intro-shade" aria-hidden="true"></div>

  <div class="intro-lights" aria-hidden="true">
    <span class="intro-light intro-light--roof-a"></span>
    <span class="intro-light intro-light--roof-b"></span>
    <span class="intro-light intro-light--middle-a"></span>
    <span class="intro-light intro-light--middle-b"></span>
    <span class="intro-light intro-light--plant"></span>
    <span class="intro-monitor intro-monitor--a"></span>
    <span class="intro-monitor intro-monitor--b"></span>
  </div>

  <div class="intro-machinery" aria-hidden="true">
    <span class="intro-rotor intro-rotor--a"><i></i></span>
    <span class="intro-rotor intro-rotor--b"><i></i></span>
    <span class="intro-haze"></span>
  </div>

  <div class="intro-brand" aria-hidden="true">
    <span class="intro-brand-mark"><i></i><i></i><i></i></span>
    <strong>ISIVOLTPRO</strong>
  </div>

  <div class="intro-copy">
    <p>CONTROL TOTAL. RENDIMIENTO REAL.</p>
    <h1>Toda tu instalación.<br /><strong>Un solo sistema.</strong></h1>
    <span>Supervisa, optimiza y controla tu instalación desde una única plataforma técnica.</span>
    <button class="intro-enter" type="button" data-intro-enter>
      Entrar en IsiVoltPro <i>→</i>
    </button>
  </div>

  <button class="intro-scroll" type="button" data-intro-enter aria-label="Entrar en IsiVoltPro">
    <i></i><span>Desliza para descubrir</span>
  </button>

  <script is:inline>
    (() => {
      const intro = document.querySelector('[data-intro]');
      if (!intro) return;

      const buttons = intro.querySelectorAll('[data-intro-enter]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const forceIntro = new URLSearchParams(window.location.search).get('intro') === '1';
      let leaving = false;

      const storageGet = (key) => {
        try { return sessionStorage.getItem(key); } catch (_) { return null; }
      };
      const storageSet = (key, value) => {
        try { sessionStorage.setItem(key, value); } catch (_) {}
      };

      const revealSite = () => {
        if (leaving) return;
        leaving = true;
        storageSet('isivoltpro-intro-seen', '1');
        intro.classList.add('is-leaving');
        document.documentElement.classList.remove('intro-active');

        if (forceIntro) {
          const cleanUrl = `${window.location.pathname}${window.location.hash || ''}`;
          window.history.replaceState({}, '', cleanUrl);
        }

        window.setTimeout(() => intro.remove(), reduced ? 50 : 900);
      };

      const seen = storageGet('isivoltpro-intro-seen') === '1';
      if (seen && !forceIntro) {
        intro.remove();
        return;
      }

      document.documentElement.classList.add('intro-active');
      requestAnimationFrame(() => intro.classList.add('is-ready'));
      buttons.forEach((button) => button.addEventListener('click', revealSite));

      const onWheel = (event) => {
        if (Math.abs(event.deltaY) > 14) revealSite();
      };
      const onKey = (event) => {
        if (['ArrowDown', 'PageDown', ' ', 'Enter', 'Escape'].includes(event.key)) revealSite();
      };
      window.addEventListener('wheel', onWheel, { passive: true, once: true });
      window.addEventListener('keydown', onKey, { once: true });

      if (!reduced && finePointer) {
        let frame = 0;
        intro.addEventListener('pointermove', (event) => {
          if (frame) cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const x = (event.clientX / window.innerWidth - 0.5) * 2;
            const y = (event.clientY / window.innerHeight - 0.5) * 2;
            intro.style.setProperty('--intro-pan-x', `${x * 0.7}%`);
            intro.style.setProperty('--intro-pan-y', `${y * 0.5}%`);
            intro.style.setProperty('--intro-tilt-x', `${x * 3}px`);
            intro.style.setProperty('--intro-tilt-y', `${y * 2}px`);
          });
        }, { passive: true });
      }
    })();
  </script>
</section>
