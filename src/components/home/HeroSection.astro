---
import '../../styles/home-hero-sales-v5.css';
interface Props { contactHref: string; }
const { contactHref } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroImage = `${base}images/hero/hero-target-v2.avif`;
---
<section class="hero-exact" aria-label="IsiVoltPro · Toda tu instalación. Un solo sistema.">
  <img class="hero-exact-image" src={heroImage} alt="IsiVoltPro: visión integral de una instalación técnica con control de climatización, bombeo, ACS, tratamiento de agua, cuadros eléctricos, sala técnica y almacenamiento." fetchpriority="high" decoding="async" />
  <div class="hero-exact-hotspots" aria-label="Accesos del Hero">
    <a class="hotspot hotspot-ecosistema" href={`${base}ecosistema`} aria-label="Ecosistema"></a>
    <a class="hotspot hotspot-aplicaciones" href={`${base}aplicaciones`} aria-label="Aplicaciones"></a>
    <a class="hotspot hotspot-mantenimiento" href={`${base}mantenimiento`} aria-label="Mantenimiento"></a>
    <a class="hotspot hotspot-recursos" href={`${base}recursos`} aria-label="Recursos"></a>
    <a class="hotspot hotspot-empresa" href={`${base}empresa`} aria-label="Empresa"></a>
    <a class="hotspot hotspot-demo" href={contactHref} aria-label="Solicitar demo"></a>
    <a class="hotspot hotspot-explorar" href="#como-funciona" aria-label="Explorar plataforma"></a>
  </div>
</section>
