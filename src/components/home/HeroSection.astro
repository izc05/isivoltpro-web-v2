---
import '../../styles/home-lighting.css';
import '../../styles/home-cinematic.css';
import '../../styles/home-hero-reference.css';
import '../../styles/home-hero-lighting-v2.css';
import '../../styles/home-hero-fallback.css';
import '../../styles/home-rebuild-approved.css';
import '../../styles/home-ecosystem-approved.css';
import '../../styles/home-hero-25d.css';
import '../../styles/home-hero-25d-strong.css';
import '../../styles/home-hero-25d-reactive.css';
import '../../styles/home-hero-power-cycle.css';
import '../../styles/home-hero-room-lighting.css';
import '../../styles/home-hero-room-overrides.css';

interface Props {
  image: string;
  contactHref: string;
}

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroImage = `${base}images/hero/hero-approved.avif`;
---
<section class="hero hero--lit hero--cinematic hero--reference hero--approved hero--25d hero--25d-strong hero--25d-reactive hero--power-cycle hero--room-lighting" data-hero-motion style={`--hero-image: url('${heroImage}')`}>
  <div class="hero-media" aria-hidden="true"></div>

  <div class="hero-depth-stack" aria-hidden="true">
    <span class="hero-depth-slice hero-depth-slice--upper"></span>
    <span class="hero-depth-slice hero-depth-slice--middle"></span>
    <span class="hero-depth-slice hero-depth-slice--lower"></span>
    <span class="hero-depth-slice hero-depth-slice--equipment"></span>
  </div>

  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-pointer-glow" aria-hidden="true"></div>

  <div class="hero-atmosphere" aria-hidden="true">
    <span class="hero-haze hero-haze--a"></span>
    <span class="hero-haze hero-haze--b"></span>
    <span class="hero-reflection"></span>
  </div>

  <div class="hero-energy-layer" aria-hidden="true">
    <span class="hero-energy-line hero-energy-line--pump"><i></i></span>
    <span class="hero-energy-line hero-energy-line--controls"><i></i></span>
    <span class="hero-energy-line hero-energy-line--lower"><i></i></span>
    <span class="hero-energy-node hero-energy-node--a"></span>
    <span class="hero-energy-node hero-energy-node--b"></span>
    <span class="hero-energy-node hero-energy-node--c"></span>
    <span class="hero-power-wave"></span>
  </div>

  <div class="hero-lighting" aria-hidden="true">
    <span class="hero-light hero-light--upper-a"></span>
    <span class="hero-light hero-light--upper-b"></span>
    <span class="hero-light hero-light--middle-a"></span>
    <span class="hero-light hero-light--middle-b"></span>
    <span class="hero-light hero-light--lower-a"></span>
    <span class="hero-light hero-light--technical"></span>

    <span class="hero-blackout hero-blackout--upper"></span>
    <span class="hero-blackout hero-blackout--middle"></span>
    <span class="hero-blackout hero-blackout--lower"></span>
    <span class="hero-flicker hero-flicker--a"></span>
    <span class="hero-flicker hero-flicker--b"></span>

    <span class="hero-monitor hero-monitor--a"></span>
    <span class="hero-monitor hero-monitor--b"></span>
    <span class="hero-monitor hero-monitor--c"></span>
  </div>

  <div class="hero-room-lighting" aria-hidden="true">
    <span class="hero-room hero-room--upper-left"></span>
    <span class="hero-room hero-room--upper-right"></span>
    <span class="hero-room hero-room--middle-left"></span>
    <span class="hero-room hero-room--middle-right"></span>
    <span class="hero-room hero-room--lower-left"></span>
    <span class="hero-room hero-room--lower-middle"></span>
    <span class="hero-room hero-room--lower-right"></span>

    <span class="hero-room-lamp hero-room-lamp--a"></span>
    <span class="hero-room-lamp hero-room-lamp--b"></span>
    <span class="hero-room-lamp hero-room-lamp--c"></span>
    <span class="hero-room-lamp hero-room-lamp--d"></span>
    <span class="hero-room-lamp hero-room-lamp--e"></span>
    <span class="hero-room-lamp hero-room-lamp--f"></span>
  </div>

  <div class="hero-control-layer" aria-hidden="true">
    <span class="hero-control-halo hero-control-halo--a"></span>
    <span class="hero-control-halo hero-control-halo--b"></span>
    <span class="hero-control-halo hero-control-halo--c"></span>
    <span class="hero-control-screen hero-control-screen--a"><i></i><b></b><b></b><b></b></span>
    <span class="hero-control-screen hero-control-screen--b"><i></i><b></b><b></b><b></b></span>
    <span class="hero-control-screen hero-control-screen--c"><i></i><b></b><b></b><b></b></span>
    <span class="hero-status-led hero-status-led--a"></span>
    <span class="hero-status-led hero-status-led--b"></span>
    <span class="hero-status-led hero-status-led--c"></span>
  </div>

  <div class="shell hero-inner">
    <div class="hero-copy hero-copy--reference">
      <p class="kicker hero-kicker" data-reveal>CONTROL TOTAL. RENDIMIENTO REAL.</p>
      <h1 class="hero-title" data-reveal>
        <span>Toda tu instalación.</span>
        <strong>Un solo sistema.</strong>
      </h1>
      <p class="hero-lead" data-reveal>Supervisa, optimiza y controla cada parte de tu instalación desde una única plataforma inteligente.</p>
      <div class="hero-actions" data-reveal>
        <a class="button button-primary" href="#como-funciona">Explorar plataforma <span>→</span></a>
      </div>
    </div>

    <div class="hero-reference-meta" data-reveal aria-label="Posicionamiento de IsiVoltPro">
      <i></i>
      <div>
        <strong>PLATAFORMA INTEGRAL</strong>
        <span>PARA INSTALACIONES TÉCNICAS</span>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#como-funciona" aria-label="Descubrir IsiVoltPro"><span>Descubrir</span><i></i></a>
</section>

<script is:inline>
  (() => {
    const hero = document.querySelector('[data-hero-motion]');
    if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let visible = false;
    let scheduleTimer = 0;
    let eventTimer = 0;
    let firstVisibleRun = true;

    const clearTimers = () => {
      window.clearTimeout(scheduleTimer);
      window.clearTimeout(eventTimer);
      scheduleTimer = 0;
      eventTimer = 0;
    };

    const scheduleNext = (first = false) => {
      window.clearTimeout(scheduleTimer);
      if (!visible || document.hidden) return;
      const delay = first ? 7600 : 30000 + Math.random() * 16000;
      scheduleTimer = window.setTimeout(runEvent, delay);
    };

    const runEvent = () => {
      if (!visible || document.hidden) {
        scheduleNext(false);
        return;
      }

      hero.classList.remove('is-power-event');
      void hero.offsetWidth;
      hero.classList.add('is-power-event');

      eventTimer = window.setTimeout(() => {
        hero.classList.remove('is-power-event');
        scheduleNext(false);
      }, 6600);
    };

    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      const nextVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= .42);
      if (nextVisible === visible) return;
      visible = nextVisible;

      if (!visible) {
        clearTimers();
        hero.classList.remove('is-power-event');
        return;
      }

      scheduleNext(firstVisibleRun);
      firstVisibleRun = false;
    }, { threshold: [0, .42, .7] });

    observer.observe(hero);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearTimers();
        hero.classList.remove('is-power-event');
      } else if (visible) {
        scheduleNext(true);
      }
    });
  })();
</script>
