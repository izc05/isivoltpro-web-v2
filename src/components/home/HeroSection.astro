---
import '../../styles/home-hero-sales-v5.css';

interface Props {
  contactHref: string;
}

const { contactHref } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroImage = `${base}images/hero/hero-main.avif`;
---
<section class="hero hero--sales-v5" data-hero-motion style={`--hero-sales-image:url('${heroImage}')`} aria-labelledby="hero-sales-title">
  <div class="sales-visual" aria-hidden="true"></div>
  <div class="sales-shade" aria-hidden="true"></div>

  <div class="shell sales-copy sales-copy--visible">
    <p class="sales-eyebrow">CONTROL TOTAL. RENDIMIENTO REAL.</p>
    <h1 id="hero-sales-title">Toda tu instalación.<br /><strong>Un solo sistema.</strong></h1>
    <p>Supervisa, optimiza y controla activos, mantenimiento, órdenes de trabajo y recursos técnicos desde una única plataforma.</p>
    <div class="sales-actions">
      <a class="button button-primary" href="#como-funciona">Explorar plataforma <span>→</span></a>
      <a class="button button-ghost" href={contactHref}>Solicitar demo <span>↗</span></a>
    </div>
    <div class="sales-proof" aria-label="Ventajas principales">
      <span><i></i>Monitorización y trazabilidad</span>
      <span><i></i>Operación conectada</span>
      <span><i></i>Histórico técnico único</span>
    </div>
  </div>

  <a class="scroll-cue sales-scroll-cue" href="#como-funciona" aria-label="Descubrir cómo funciona IsiVoltPro"><span>Descubrir</span><i></i></a>
</section>
