---
import '../../styles/home-lighting.css';

interface Props {
  image: string;
  video: string;
  contactHref: string;
}

const { image, video, contactHref } = Astro.props;
---
<section class="hero hero--lit hero--video" style={`--hero-image: url('${image}')`}>
  <div class="hero-media" aria-hidden="true"></div>
  <video
    class="hero-video"
    data-hero-video
    muted
    loop
    playsinline
    preload="auto"
    poster={image}
    aria-hidden="true"
  >
    <source src={video} type="video/mp4" />
  </video>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-lighting" aria-hidden="true">
    <span class="hero-light hero-light--plant"></span>
    <span class="hero-light hero-light--room"></span>
    <span class="hero-light hero-light--service"></span>
    <span class="hero-light hero-light--cool"></span>
    <span class="hero-monitor hero-monitor--a"></span>
    <span class="hero-monitor hero-monitor--b"></span>
  </div>

  <div class="shell hero-inner">
    <div class="hero-copy">
      <p class="kicker hero-kicker" data-reveal>CONTROL TOTAL. RENDIMIENTO REAL.</p>
      <h1 class="hero-title" data-reveal>
        <span>Toda tu instalación.</span>
        <strong>Un solo sistema.</strong>
      </h1>
      <p class="hero-lead" data-reveal>Supervisa activos, mantenimiento, órdenes de trabajo y recursos técnicos desde una única plataforma conectada.</p>
      <div class="hero-actions" data-reveal>
        <a class="button button-primary" href="#como-funciona">Explorar plataforma <span>→</span></a>
        <a class="button button-ghost" href={contactHref}>Solicitar demo <span>↗</span></a>
      </div>
      <div class="hero-value-points" data-reveal aria-label="Beneficios principales">
        <span>Monitorización y trazabilidad</span>
        <span>Operación conectada</span>
        <span>Histórico técnico único</span>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#como-funciona" aria-label="Descubrir IsiVoltPro"><span>Descubrir</span><i></i></a>
</section>
