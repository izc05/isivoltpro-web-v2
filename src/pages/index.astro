---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Motion from '../components/Motion.astro';
import HeroSection from '../components/home/HeroSection.astro';
import '../styles/global.css';
import '../styles/home-sections.css';
import '../styles/home-design-v4.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => href === '/' ? base : `${base}${href.replace(/^\/+/, '')}`;
const heroSalesImage = `${base}images/hero/hero-isivoltpro-sales.webp`;
const closingImage = 'https://images.pexels.com/photos/31257317/pexels-photo-31257317.jpeg?auto=compress&cs=tinysrgb&w=2200';

const flow = [
  { n: '01', title: 'Activo', signal: 'Identificación', text: 'Cada equipo parte de una ficha única con ubicación, contexto técnico, QR/NFC y documentación.', label: 'Contexto', value: 'Centralizado' },
  { n: '02', title: 'Incidencia', signal: 'Detección', text: 'Una anomalía se registra con prioridad, evidencias y toda la información necesaria para actuar.', label: 'Entrada', value: 'Trazable' },
  { n: '03', title: 'Orden de trabajo', signal: 'Ejecución', text: 'La necesidad se convierte en trabajo asignado, con técnico, estado, tiempos y seguimiento.', label: 'Operación', value: 'En curso' },
  { n: '04', title: 'Histórico', signal: 'Aprendizaje', text: 'El cierre conserva actuaciones, evidencias y decisiones para entender la instalación con el tiempo.', label: 'Memoria', value: 'Disponible' }
];

const products = [
  { n: '01', state: 'Operativa', kind: 'tools', title: 'Herramientas QR/NFC', text: 'Inventario, identificación, responsables, préstamos, devoluciones e historial.', href: '/aplicaciones' },
  { n: '02', state: 'Operativa', kind: 'ot', title: 'IsiVoltPro OT', text: 'Clientes, instalaciones, órdenes de trabajo, técnicos, estados y seguimiento.', href: '/aplicaciones' },
  { n: '03', state: 'Beta', kind: 'bt', title: 'Preinspecciones BT', text: 'Trabajo guiado, mediciones, evidencias y preparación estructurada de la preinspección.', href: '/aplicaciones' }
];

const ecosystem = ['Activos', 'OT', 'Mantenimiento', 'Herramientas', 'Inventario', 'Especialidades'];

const sectors = [
  { title: 'Hospitales', image: 'https://images.pexels.com/photos/5203594/pexels-photo-5203594.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Industria', image: 'https://images.pexels.com/photos/5953729/pexels-photo-5953729.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Edificios', image: 'https://images.pexels.com/photos/16370914/pexels-photo-16370914.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Infraestructura', image: 'https://images.pexels.com/photos/17387403/pexels-photo-17387403.jpeg?auto=compress&cs=tinysrgb&w=1200' }
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="IsiVoltPro centraliza activos, mantenimiento, órdenes de trabajo, QR/NFC, inventario e histórico técnico para darte una visión única de toda tu instalación." />
    <meta name="theme-color" content="#020812" />
    <link rel="preload" as="image" href={heroSalesImage} type="image/webp" fetchpriority="high" />
    <title>IsiVoltPro · Toda tu instalación. Un solo sistema.</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />

    <main id="contenido">
      <HeroSection contactHref={withBase('/contacto')} />

      <section class="operations-section" id="como-funciona">
        <div class="shell operations-layout">
          <div class="operations-copy" data-reveal>
            <div>
              <p class="kicker">El sistema operativo de tu instalación</p>
              <h2>De la señal al histórico.<br /><span>Sin perder el contexto.</span></h2>
            </div>
            <p>IsiVoltPro une lo que normalmente queda repartido entre avisos, hojas, llamadas y aplicaciones distintas. Cada paso deja contexto para el siguiente.</p>
            <div class="operations-proof" aria-label="Principios de operación de IsiVoltPro">
              <div><strong>Un dato</strong><span>Una única fuente de contexto</span></div>
              <div><strong>Un flujo</strong><span>Estados claros y trazables</span></div>
              <div><strong>Un histórico</strong><span>Todo queda conectado</span></div>
            </div>
          </div>

          <div class="operations-console" data-reveal>
            <div class="operations-console-bar">
              <div><i></i><strong>Operación en tiempo real</strong></div>
              <span>Instalación · Granada · Sistema estable</span>
            </div>

            <div class="operations-track">
              {flow.map((item) => (
                <article class="operation-stage">
                  <span class="operation-index">{item.n}</span>
                  <div class="operation-main">
                    <div class="operation-meta"><i></i><span>{item.signal}</span></div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                  <div class="operation-status">
                    <span>{item.label}</span>
                    <strong>{item.value}</strong>
                  </div>
                </article>
              ))}
            </div>

            <div class="operations-feed">
              <article>
                <span>Último cambio</span>
                <strong>OT #2481 · Bombeo principal</strong>
                <p>Incidencia convertida en orden de trabajo con prioridad alta y técnico asignado.</p>
              </article>
              <article>
                <span>Trazabilidad</span>
                <strong>4 eventos conectados</strong>
                <p>Activo, aviso, actuación y cierre quedan unidos en una única secuencia operativa.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="products-section products-section--v4" id="productos">
        <div class="shell">
          <div class="product-heading" data-reveal>
            <div>
              <p class="kicker">Aplicaciones que trabajan juntas</p>
              <h2>Herramientas reales.<br /><span>Un mismo ecosistema.</span></h2>
            </div>
            <p>Cada aplicación resuelve una necesidad concreta, pero todas comparten la misma lógica: identificar, actuar, registrar y mantener el contexto.</p>
          </div>

          <div class="product-grid">
            {products.map((product, index) => (
              <article class="product-card" data-reveal style={`--delay:${index * 90}ms`}>
                <div class:list={['product-visual', `is-${product.kind}`]} aria-label={`Vista conceptual de ${product.title}`}>
                  <span class="concept-label">Vista de producto</span>
                  <div class="device-shell">
                    <div class="device-top"><i></i><i></i><i></i></div>
                    <div class="device-body">
                      {product.kind === 'tools' && <><div class="visual-qr"></div><div class="visual-lines"><i></i><i></i><i></i></div></>}
                      {product.kind === 'ot' && <><div class="visual-sidebar"></div><div class="visual-board"><i></i><i></i><i></i><i></i></div></>}
                      {product.kind === 'bt' && <><div class="visual-progress"></div><div class="visual-checks"><i></i><i></i><i></i><i></i></div></>}
                    </div>
                  </div>
                </div>
                <div class="product-copy">
                  <div class="product-meta"><span>{product.n} · IsiVoltPro</span><b class:list={[product.state === 'Beta' && 'is-beta']}>{product.state}</b></div>
                  <h3>{product.title}</h3>
                  <p>{product.text}</p>
                  <a href={withBase(product.href)}>Conocer aplicación <span>→</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ecosystem-band">
        <div class="shell ecosystem-inner" data-reveal>
          <div class="ecosystem-copy">
            <p class="kicker">Un ecosistema que sigue creciendo</p>
            <h2>Todo lo que tu instalación necesita.<br /><span>En un solo lugar.</span></h2>
          </div>
          <div class="ecosystem-list">
            {ecosystem.map((item, index) => <a href={withBase('/ecosistema')}><span>{String(index + 1).padStart(2,'0')}</span><strong>{item}</strong><i>→</i></a>)}
          </div>
        </div>
      </section>

      <section class="sectors-section">
        <div class="shell">
          <div class="sector-heading" data-reveal>
            <p class="kicker">Diseñado para cada entorno</p>
            <h2>Un mismo estándar,<br /><span>en cada sector.</span></h2>
          </div>
          <div class="sector-grid">
            {sectors.map((sector, index) => (
              <a class="sector-card" href={withBase('/mantenimiento')} style={`--sector-image:url('${sector.image}');--delay:${index * 80}ms`} data-reveal>
                <span>{sector.title}</span><i>↗</i>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="closing-section" style={`--closing-image:url('${closingImage}')`}>
        <div class="closing-media" aria-hidden="true"></div>
        <div class="closing-shade" aria-hidden="true"></div>
        <div class="closing-lighting" aria-hidden="true">
          <span class="closing-light closing-light--a"></span>
          <span class="closing-light closing-light--b"></span>
          <span class="closing-monitor"></span>
        </div>
        <div class="shell closing-inner" data-reveal>
          <p class="kicker">Una visión más clara de tu operación</p>
          <h2>Tu instalación.<br /><span>Bajo control.</span></h2>
          <p>Menos información dispersa. Más contexto para decidir, actuar y mantener.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={withBase('/contacto')}>Solicitar demo <span>↗</span></a>
            <a class="button button-ghost" href={withBase('/ecosistema')}>Explorar ecosistema <span>→</span></a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <Motion />
  </body>
</html>
